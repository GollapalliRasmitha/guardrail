# Copy to .env (start-guardrail.ps1 does it for you and fills the local keys).
# NEVER commit .env. NEVER paste these values into chat.

# Postgres. Local Docker: postgres://guardrail:guardrail@localhost:5434/guardrail
DATABASE_URL=

# The address the app is opened at (used for the Origin check). Local: http://localhost:3100
APP_URL=

# 32 random bytes, base64. Encrypts the 2FA secret in the database.
ENCRYPTION_KEY=

# 32 random bytes, base64. Key for hashing IPs and emails (rate limits, counting).
HASH_SECRET=

# Signing secrets for event intake, one per site (32+ random characters).
# The SAME value goes into that site's own settings later (Stage 3/5). Empty = that site's events are refused.
INGEST_SECRET_HOMEHAAT=
INGEST_SECRET_OPPORA=
